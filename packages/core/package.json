{
  "name": "@proximate/core",
  "version": "0.1.0",
  "description": "Vanilla JavaScript runtime for ProXimate",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^7.2.0",
    "typescript": "^5.3.0"
  },
  "author": "ProgrammerKR",
  "license": "MIT"
}
